{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["facedetection"],
  "ios": {
    "iosModuleName": "FaceDetection"
  },
  "android": {
    "androidNamespace": ["facedetection"],
    "androidCxxLibName": "FaceDetection"
  },
  "autolinking": {
    "FaceDetectionFrameProcessor": {
      "ios": {
        "language": "swift",
        "implementationClassName": "FaceDetectionFrameProcessor"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "FaceDetectionFrameProcessor"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
